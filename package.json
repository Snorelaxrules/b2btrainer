{
  "name": "b2btrainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "plan": "node --import ./scripts/ts-hooks.mjs scripts/plan.ts",
    "agree": "node --import ./scripts/ts-hooks.mjs scripts/agree.ts",
    "extract": "node scripts/replay/extract.mjs",
    "replay-check": "node scripts/replay/check.mjs",
    "tune": "node --import ./scripts/ts-hooks.mjs scripts/tune.ts",
    "fixtures": "node --import ./scripts/ts-hooks.mjs scripts/fixtures.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@haelp/teto": "^4.2.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
